# Help Desk & Ticketing System - Environment Variables

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/helpdesk

# Authentication
JWT_SECRET=change_this_to_a_strong_secret_key
JWT_EXPIRES_IN=1d

# Application
APP_NAME=Help Desk Ticketing System
APP_URL=http://localhost:3000

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10MB