# Environment variables for Help Desk & Ticketing System

# Application
APP_NAME=Help Desk Ticketing System
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helpdesk
DB_USERNAME=root
DB_PASSWORD=

# Authentication
JWT_SECRET=change-this-to-a-secret-key
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10MB